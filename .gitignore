# Variáveis de ambiente reais (contêm senha) — só o .env.example é versionado
.env

# Artefatos de build do .NET
bin/
obj/
*.user
*.suo

# Executáveis baixados à mão (ex.: k8s/k3d.exe)
*.exe

# IDEs
.vs/
.vscode/
.idea/

# Python (gerador de carga, etapas futuras)
__pycache__/
.venv/

# Carga de aquecimento dos testes: descartada de propósito, não entra nas medições
resultados/**/descartado/
