# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# O .env NÃO vai para o git; este arquivo de exemplo vai.
# No Kubernetes, o Secret é criado a partir deste mesmo arquivo:
#   kubectl create secret generic banco-credenciais -n aps --from-env-file=.env
# Os manifestos só leem do Secret as chaves POSTGRES_USER e POSTGRES_PASSWORD.

# Versão (tag) das imagens construídas — nunca usar só "latest"
APP_VERSION=1.1.0

# ---------- PostgreSQL ----------
POSTGRES_USER=aps
POSTGRES_PASSWORD=troque-esta-senha
# Porta exposta no host (para inspecionar o banco com DBeaver/pgAdmin)
POSTGRES_PORT=5432

# ---------- Portas das APIs no host (Compose) ----------
AIR_QUALITY_API_PORT=5001
FLOODING_API_PORT=5002
THERMAL_INVERSION_API_PORT=5003

# ---------- Regras de alerta ----------
# Qualidade do ar: alerta quando PM2.5 (µg/m³) passa do limite por N leituras seguidas
AIR_PM25_LIMIT=25
AIR_PM25_CONSECUTIVE_READINGS=3
# Alagamento: alerta quando o nível da água (cm) passa da cota de transbordamento
FLOODING_OVERFLOW_LEVEL_CM=300
# Inversão térmica: alerta quando (temp. superior - temp. superfície) passa deste valor (°C)
THERMAL_MIN_INVERSION_GRADIENT_C=0
