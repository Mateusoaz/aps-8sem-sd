# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# O .env NÃO vai para o git; este arquivo de exemplo vai.
# No Kubernetes, o Secret é criado a partir deste mesmo arquivo:
#   kubectl create secret generic aps-credenciais -n aps --from-env-file=.env
# Os manifestos só leem do Secret as chaves POSTGRES_* e RABBITMQ_*.

# Versão (tag) das imagens construídas — nunca usar só "latest"
APP_VERSION=1.1.0

# ---------- PostgreSQL ----------
POSTGRES_USER=aps
POSTGRES_PASSWORD=troque-esta-senha
# Porta exposta no host (para inspecionar o banco com DBeaver/pgAdmin)
POSTGRES_PORT=5432

# ---------- RabbitMQ (fila) ----------
# A senha entra numa URL amqp://usuario:senha@host: use só letras, números, - e _
RABBITMQ_USER=aps
RABBITMQ_PASSWORD=troque-esta-senha
# Painel de administração da fila no host (Compose): http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- Cache (Redis) e fila: ligar/desligar sem recompilar ----------
CACHE_ENABLED=true
# Por quantos segundos uma consulta agregada fica no cache
CACHE_TTL_SECONDS=10
# false = o alerta é avaliado dentro do POST (síncrono), sem passar pela fila
QUEUE_ENABLED=true

# ---------- Portas no host (Compose) ----------
AIR_QUALITY_API_PORT=5001
FLOODING_API_PORT=5002
THERMAL_INVERSION_API_PORT=5003
# Cliente web: http://localhost:8080
WEB_CLIENT_PORT=8080

# ---------- Regras de alerta ----------
# Qualidade do ar: alerta quando PM2.5 (µg/m³) passa do limite por N leituras seguidas
AIR_PM25_LIMIT=25
AIR_PM25_CONSECUTIVE_READINGS=3
# Alagamento: alerta quando o nível da água (cm) passa da cota de transbordamento
FLOODING_OVERFLOW_LEVEL_CM=300
# Inversão térmica: alerta quando (temp. superior - temp. superfície) passa deste valor (°C)
THERMAL_MIN_INVERSION_GRADIENT_C=0
